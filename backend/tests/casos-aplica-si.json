    { "expresion": "lleva_cables || lleva_rolados && lleva_placas_base", "atributos": { "lleva_rolados": true }, "aplica": false, "conocida": true },
    { "expresion": "  lleva_membrana  ", "atributos": { "lleva_membrana": true }, "aplica": true, "conocida": true },
    { "expresion": "lleva_lona", "atributos": { "lleva_membrana": false }, "aplica": true, "conocida": false },
    { "expresion": "!lleva_membrana", "atributos": { "lleva_membrana": true }, "aplica": true, "conocida": false },
    { "expresion": "lleva_membrana ||", "atributos": { "lleva_membrana": false }, "aplica": true, "conocida": false },
    { "expresion": "(lleva_membrana", "atributos": { "lleva_membrana": false }, "aplica": true, "conocida": false },
    { "expresion": "acabado_estructura == 'pintura", "atributos": { "acabado_estructura": "galvanizado" }, "aplica": true, "conocida": false },
    { "expresion": "acabado_estructura != 'pintura'", "atributos": { "acabado_estructura": "pintura" }, "aplica": true, "conocida": false },
